rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) { return request.auth != null && request.auth.uid == uid; }
    function validProfile(d) {
      return d.keys().hasAll(['name','email','photoUrl','coupleId','createdAt','updatedAt'])
        && d.keys().hasOnly(['name','email','photoUrl','coupleId','createdAt','updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && d.email is string && d.email.size() > 0 && d.email.size() <= 254
        && (d.photoUrl == null || (d.photoUrl is string && d.photoUrl.size() <= 2048))
        && (d.coupleId == null || (d.coupleId is string && d.coupleId.size() > 0))
        && d.createdAt is timestamp && d.updatedAt is timestamp;
    }
    match /users/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;
      allow create: if isOwner(uid) && validProfile(request.resource.data)
        && request.auth.token.email != null && request.resource.data.email == request.auth.token.email
        && request.resource.data.coupleId == null && request.resource.data.photoUrl == null
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if isOwner(uid) && validProfile(request.resource.data) && request.resource.data.updatedAt == request.time
        && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','photoUrl','updatedAt']));
      allow delete: if false;
    }
    match /couples/{coupleId} {
      allow get: if request.auth != null && request.auth.uid in resource.data.memberIds
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.coupleId == coupleId;
      allow list, create, update, delete: if false;
    }
    // Backend Admin SDK alone reads hashes and performs all membership writes.
    match /invitations/{invitationId} {
      allow read, write: if false;
      match /{document=**} { allow read, write: if false; }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
