rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function validProfile(data) {
      return data.keys().hasAll(['name', 'email', 'photoUrl', 'coupleId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['name', 'email', 'photoUrl', 'coupleId', 'createdAt', 'updatedAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.email is string && data.email.size() > 0 && data.email.size() <= 254
        && (data.photoUrl == null || (data.photoUrl is string && data.photoUrl.size() <= 2048))
        && (data.coupleId == null || (data.coupleId is string && data.coupleId.size() > 0))
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }
    match /users/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;
      allow create: if isOwner(uid) && validProfile(request.resource.data)
        && request.auth.token.email != null
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.coupleId == null
        && request.resource.data.photoUrl == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isOwner(uid) && validProfile(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'photoUrl', 'updatedAt'])
        && request.resource.data.updatedAt == request.time;
      // Membership, email synchronization, and account deletion require a trusted backend.
      allow delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
